{
  "expo": {
    "name": "curious-minds",
    "slug": "curious-minds",
    "scheme": "curiousminds",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F6F9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.selfhelp.curiousminds"
    },
    "android": {
      "package": "com.selfhelp.curiousminds",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F6F9"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-audio",
      "expo-video",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "54a8e106-a801-4c60-b114-d301cac5986d"
      }
    },
    "owner": "sonu.prajapati630766"
  }
}
